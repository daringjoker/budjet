{
  "name": "@budjet/backend",
  "version": "0.0.1",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./trpc": "./src/trpc/router.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "db:generate": "node --import tsx/esm node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@budjet/shared": "workspace:*",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.38.0",
    "dotenv": "^16.4.0",
    "zod": "^3.22.0",
    "imapflow": "^1.0.0",
    "node-llama-cpp": "^3.0.0",
    "@trpc/server": "^11.0.0",
    "hono": "^4.2.0",
    "@hono/trpc-server": "^0.3.0",
    "@hono/node-server": "^1.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  }
}
